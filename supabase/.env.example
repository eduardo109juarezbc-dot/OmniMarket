# Variables del stack local de Supabase (npx supabase start). Copia a supabase/.env.
# Con valores ficticios el stack arranca y los botones redirigen al proveedor;
# para completar un login real en local usa las credenciales de tu OAuth app de desarrollo
# (callback: http://127.0.0.1:54321/auth/v1/callback).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=dummy-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=dummy-google-secret
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=dummy-github-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=dummy-github-secret
