# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# --- Supabase (públicas: se incluyen en el bundle del cliente) ---
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Base de datos (solo servidor) ---
# Pooler en modo transacción (puerto 6543). Usado por la app en runtime.
DATABASE_URL=
# Pooler en modo sesión (puerto 5432). Usado por migraciones y seed.
DATABASE_URL_DIRECT=

# --- Endpoints de auditoría ---
# Secreto para POST /api/test/reset-data (cabecera x-test-token). Mínimo 16 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEST_API_TOKEN=

# --- Solo E2E (stack local de Supabase) ---
# Se usa en e2e/global-setup.ts para crear el usuario de prueba. No configurar en producción.
SUPABASE_SERVICE_ROLE_KEY=

# --- Formato (opcionales) ---
# Origen público de la app, usado por el smoke test y la documentación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Código ISO 4217 y locale BCP 47. Por defecto: USD y es-ES.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=es-ES
# Zona horaria IANA para mostrar fechas. Por defecto: UTC.
NEXT_PUBLIC_TIME_ZONE=UTC
